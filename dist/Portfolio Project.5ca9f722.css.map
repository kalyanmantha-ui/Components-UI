.card-preview-video {
  object-fit: cover;
  filter: drop-shadow(0 0 10px #00b4ff80) drop-shadow(0 0 20px #ffc8644d);
  border-radius: 15px;
  width: 100%;
  height: 250px;
  margin-bottom: 10px;
  transition: transform .3s, filter .3s;
}

.animatedCard-content {
  position: relative;
}

.card-preview-video:after {
  content: "";
  background: #0000001a;
  border-radius: 10px;
  position: absolute;
  inset: 0;
}

.animatedCard:hover .card-preview-video {
  filter: drop-shadow(0 0 15px #ffd250cc) drop-shadow(0 0 25px #00b4ffb3);
  transform: scale(1.1);
}

body {
  color: #e8ecf5;
  background-color: #0000;
  background-image: radial-gradient(circle at 30% 30%, #0078ff26, #0000 60%), radial-gradient(circle at 70% 70%, #ffc8501f, #0000 60%), linear-gradient(#060b17 0%, #000 100%);
  background-position: 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat;
  background-size: auto, auto, auto;
  background-attachment: fixed;
  background-origin: padding-box, padding-box, padding-box;
  background-clip: border-box, border-box, border-box;
  margin: 0;
  padding: 0;
  font-family: Inter, sans-serif;
  transition: background .6s, color .3s;
}

.naruto-runner {
  z-index: 20;
  pointer-events: none;
  filter: drop-shadow(0 0 10px #ffb43ccc) drop-shadow(0 0 20px #0096ff80);
  justify-content: center;
  align-items: center;
  width: 120px;
  height: 120px;
  animation: 14s linear infinite narutoRunAcross;
  display: flex;
  position: fixed;
  bottom: 120px;
  left: -150px;
}

@keyframes narutoRunAcross {
  0% {
    transform: translateX(-10vw);
  }

  80% {
    transform: translateX(110vw);
  }

  90%, 100% {
    transform: translateX(110vw);
  }
}

.logo {
  letter-spacing: .5px;
  color: #e8f3ff;
  text-shadow: 0 0 8px #00b4ff80, 0 0 20px #ffdc8233;
  align-items: center;
  gap: 6px;
  font-size: 1.5rem;
  font-weight: 700;
  display: flex;
}

.navLinks {
  align-items: center;
  gap: 14px;
  display: flex;
}

.navButton, .resumeButton {
  color: #fff !important;
  cursor: pointer !important;
  background: linear-gradient(145deg, #007bff, #0af) !important;
  border: none !important;
  border-radius: 12px !important;
  justify-content: center !important;
  align-items: center !important;
  width: 150px !important;
  height: 45px !important;
  padding: 0 !important;
  font-size: 16px !important;
  font-weight: 500 !important;
  line-height: 1 !important;
  text-decoration: none !important;
  transition: all .3s !important;
  display: inline-flex !important;
  box-shadow: 0 0 12px #0096ff66 !important;
}

.navButton:hover, .resumeButton:hover {
  background: linear-gradient(145deg, #09f, #3cf) !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 0 20px #00b4ff99 !important;
}

.resumeButton:link, .resumeButton:visited {
  color: #fff !important;
  text-decoration: none !important;
}

.footer {
  backdrop-filter: blur(10px);
  text-align: center;
  color: #aab8cc;
  z-index: 1000;
  background: #0a0c14e6;
  border-top: 1px solid #0096ff33;
  width: 100%;
  padding: 12px 0;
  font-size: 13px;
  transition: background .4s;
  position: relative;
  box-shadow: 0 -1px 20px #0096ff1a;
}

.footer a {
  color: #0af;
  margin-left: 6px;
  font-weight: 500;
  text-decoration: none;
  transition: color .3s, text-shadow .3s;
}

.footer a:hover {
  color: #3cf;
  text-shadow: 0 0 8px #00c8ff99;
}

@keyframes cardBreath {
  0%, 100% {
    box-shadow: 0 0 15px #00a0ff40, inset 0 0 15px #008cff1f;
  }

  50% {
    box-shadow: 0 0 35px #ffc86459, inset 0 0 25px #00a0ff40;
  }
}

@keyframes fadeIn {
  to {
    opacity: 1;
  }
}

@keyframes fadeOut {
  to {
    opacity: 0;
    transform: translateY(40px);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(.9)translateY(-10px);
  }

  to {
    opacity: 1;
    transform: scale(1)translateY(0);
  }
}

@keyframes scaleOut {
  from {
    opacity: 1;
    transform: scale(1)translateY(0);
  }

  to {
    opacity: 0;
    transform: scale(.9)translateY(-10px);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.naruto-runner .tenor-gif-embed {
  background: radial-gradient(circle, #ffb43c0d, #0000);
  border-radius: 50%;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.containerCards {
  grid-template-columns: repeat(3, 1fr);
  justify-items: center;
  gap: 2.5vw;
  padding: 4vh 8vw 9.5vh;
  display: grid;
}

.animatedCard {
  cursor: pointer;
  perspective: 1000px;
  backdrop-filter: blur(.25rem);
  background: radial-gradient(circle at 30% 20%, #191e2df2, #0f121ceb);
  border: 1px solid #00b4ff2e;
  border-radius: 1.2vw;
  width: 100%;
  max-width: 28vw;
  height: 45vh;
  transition: transform .4s, box-shadow .4s, border .4s;
  animation: 4s ease-in-out infinite cardBreath;
  position: relative;
  overflow: hidden;
  box-shadow: 0 .375rem 1.125rem #0009, 0 0 1.25rem #00b4ff1f, inset 0 0 .75rem #ffffff0d;
}

.animatedCard:hover {
  background: radial-gradient(circle at 20% 30%, #1c2337f5, #0a0f19f2);
  border: 1px solid #ffd26480;
  transform: translateY(-8px)rotateX(3deg)rotateY(1deg)scale(1.05);
  box-shadow: 0 10px 30px #ffd2644d, 0 0 40px #00b4ff40, inset 0 0 25px #00c8ff33;
}

.animatedCard:after {
  content: "";
  background: linear-gradient(115deg, #0000, #ffffff59, #ffffff0d, #0000);
  width: 70%;
  height: 100%;
  transition: left 1s ease-in-out;
  position: absolute;
  top: 0;
  left: -150%;
  transform: skewX(-25deg);
}

.animatedCard:hover:after {
  left: 200%;
}

.animatedCard-inner {
  color: #f0f6ff;
  text-align: left;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  height: 100%;
  padding: 1.625rem;
  transition: all .3s;
  display: flex;
}

.animatedCard-content h3 {
  letter-spacing: .031rem;
  color: #e9f4ff;
  text-shadow: 0 0 .625rem #00b4ff66;
  margin: .5rem 0;
  font-size: 1.375rem;
  font-weight: 600;
}

.animatedCard-content p {
  color: #9fb2c9;
  margin: 0;
  font-size: .9375rem;
  line-height: 1.6;
}

.icon {
  color: #fc6;
  text-shadow: 0 0 .625rem #ffdc7880, 0 0 1.25rem #0096ff4d;
  margin-bottom: .625rem;
  font-size: 2.125rem;
}

.animatedCard.active {
  background: radial-gradient(circle, #1e283cfa, #0a0e14f2);
  border: 1px solid #ffc86499;
  animation: none;
  transform: scale(1.05);
  box-shadow: 0 0 45px #00c8ffcc, inset 0 0 45px #00b4ff66;
}

.modal {
  z-index: 10000;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  animation-duration: .3s;
  animation-fill-mode: forwards;
  display: flex;
  position: fixed;
  top: 0;
  left: 0;
}

.modalInner {
  color: #000;
  background-color: #fff;
  border-radius: 1rem;
  flex-direction: column;
  width: 70%;
  height: 50%;
  padding: 1.5rem;
  animation-duration: .3s;
  animation-fill-mode: forwards;
  display: flex;
  box-shadow: 0 .5rem 2rem #00000040;
}

.description {
  text-align: center;
  justify-content: center;
  font-size: 1.125rem;
}

.accordinContainer {
  width: 80%;
  height: 60%;
  padding: 0 0 0 30%;
}

.title {
  cursor: pointer;
}

.accordinItem {
  border: 1px solid #ccc;
  border-radius: .625rem;
  width: 50%;
  margin: .625rem;
  padding: .625rem;
  transition: box-shadow .25s;
}

.accordinItem:hover {
  box-shadow: 0 3px 10px #00000026;
}

.close {
  cursor: pointer;
  color: #777;
  background: none;
  border: none;
  align-self: flex-end;
  font-size: 1.4rem;
  transition: color .2s;
}

.close:hover {
  color: #000;
}

.tabButton {
  width: 1.25rem;
  height: .625rem;
}

.TabsContainer {
  border: 1px solid gray;
  border-radius: .9375rem;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 30%;
  height: 60%;
  display: flex;
}

.TabsMain {
  justify-content: center;
  align-items: center;
  height: 70vh;
  display: flex;
}

.modalMain {
  z-index: 10000;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  animation-duration: .3s;
  animation-fill-mode: forwards;
  display: flex;
  position: fixed;
  top: 0;
  left: 0;
}

.fade-in {
  animation-name: fadeIn;
}

.fade-out {
  animation-name: fadeOut;
}

.modalInnerModal {
  background-color: #fff;
  border-radius: 1rem;
  flex-direction: column;
  width: 70%;
  height: 50%;
  padding: 1.5rem;
  animation-duration: .3s;
  animation-fill-mode: forwards;
  display: flex;
  box-shadow: 0 .5rem 2rem #00000040;
}

.scale-in {
  animation-name: scaleIn;
}

.scale-out {
  animation-name: scaleOut;
}

.tooltipMain {
  text-align: center;
  justify-content: center;
  align-items: center;
  height: auto;
  display: flex;
}

.textToShowToolTip {
  opacity: 0;
  white-space: nowrap;
  background-color: beige;
  border-radius: .5rem;
  width: fit-content;
  padding: .3125rem .625rem;
  font-size: .875rem;
  transition: opacity .2s ease-in-out;
  position: absolute;
  top: 90%;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 .125rem .3125rem #0003;
}

.tooltipMain:hover .textToShowToolTip {
  opacity: 1;
}

.centeringTooltip {
  position: fixed;
}

.Dropdownbutton {
  text-align: center;
  color: #fff;
  cursor: pointer;
  background-color: #00f;
  border-radius: .9375rem;
  width: 9.375vw;
  height: 2.5vw;
  padding: 0 .3125rem .125rem;
  display: flex;
}

.arrowDropdown {
  margin-left: 6px;
  transition: transform .3s;
  display: inline-block;
}

.rotateRight {
  transform: rotate(0);
}

.rotateDown {
  transform: rotate(90deg);
}

.Dropdowncontent {
  opacity: 0;
  background-color: #faebd7;
  border-radius: .9375rem;
  flex-direction: column;
  width: 12.5vw;
  max-height: 0;
  margin-top: .625rem;
  padding: 0 .625rem;
  transition: max-height .4s, opacity .3s, transform .3s;
  display: flex;
  position: absolute;
  top: 100%;
  left: 42%;
  overflow: hidden;
  transform: translateY(-.625rem);
}

.Dropdowncontent.active {
  opacity: 1;
  max-height: 18.75vw;
  transform: translateY(0);
}

.DropdownMain {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: .625rem;
  display: flex;
  position: relative;
}

.mini-container {
  border: 1px solid #000;
  flex-flow: column;
  align-items: flex-start;
  width: 13.125vw;
  margin: .0625rem;
  padding: .3125rem;
  display: flex;
}

.image {
  width: 11.875vw;
  height: 12.5vw;
}

.products-container {
  flex-wrap: wrap;
  display: flex;
}

.page {
  cursor: pointer;
  border: 1px solid #000;
  margin: .25rem;
  padding: .1875rem;
}

.button {
  cursor: pointer;
  background-color: #d3d3d3;
  border: 1px solid #000;
  width: .3125rem;
  margin: .3125rem;
  padding: .3125rem;
}

.activePagination {
  background-color: gray;
}

.navigation {
  margin: .625rem;
  padding: .3125rem;
  display: inline-block;
}

.PaginationMain {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  display: flex;
}

.DataTableMain {
  padding: 1.25rem;
  font-family: sans-serif;
}

button {
  cursor: pointer;
  background-color: #fff;
  border: 1px solid #ccc;
  border-radius: .375rem;
  margin: .3125rem;
  padding: .375rem .625rem;
}

table {
  border-collapse: collapse;
  width: 100%;
  margin-top: .9375rem;
}

td {
  text-align: center;
  border: 1px solid #000;
  padding: .5rem;
}

.progressBarContainer {
  width: 100%;
}

.progressBarC {
  background-color: #ccc;
  border-radius: .3125rem;
  height: 1.25rem;
}

.progressBar {
  background-color: green;
  border-radius: 5px;
  height: 100%;
}

.ToggleMain {
  justify-content: center;
  align-items: center;
  gap: 10px;
  width: 100%;
  height: 100vh;
  font-family: sans-serif;
  transition: background-color .5s, color .5s;
  display: flex;
}

.TogglePill {
  cursor: pointer;
  background-color: beige;
  border-radius: 1.5625rem;
  width: 12.5rem;
  height: 3.125rem;
  transition: background-color .4s;
  position: relative;
  overflow: hidden;
}

.toggleCircle {
  background-color: #fff;
  border-radius: 50%;
  width: 3.125rem;
  height: 3.125rem;
  transition: transform .4s;
  display: inline-block;
  position: absolute;
  top: 0;
  left: 0;
}

.light .TogglePill {
  background-color: beige;
}

.light .toggleCircle {
  background-color: #fff;
}

.light {
  color: #000;
  background-color: #fff;
}

.dark .TogglePill {
  background-color: #444;
}

.dark .toggleCircle {
  background-color: #f9f9f9;
}

.dark {
  color: #fff;
  background-color: #222;
}

.toastWrapper {
  flex-direction: column;
  align-items: center;
  margin-top: 6.25rem;
  font-family: sans-serif;
  display: flex;
}

.toast {
  color: #fff;
  background-color: #333;
  border-radius: .625rem;
  padding: .9375rem 1.5625rem;
  font-size: 1rem;
  animation: .4s slideUp, .5s 2.5s forwards fadeOut;
  position: fixed;
  bottom: 1.875rem;
  right: 1.875rem;
  box-shadow: 0 .25rem .625rem #0000004d;
}

.searchContainer {
  flex-direction: column;
  align-items: center;
  margin-top: 5rem;
  font-family: sans-serif;
  display: flex;
  position: relative;
}

.searchInput {
  border: .125rem solid #aaa;
  border-radius: .5rem;
  outline: none;
  width: 15.625rem;
  padding: .625rem;
  font-size: 1rem;
  transition: all .2s;
}

.searchInput:focus {
  border-color: #007bff;
  box-shadow: 0 0 .25rem #007bff66;
}

.searchResults {
  z-index: 100;
  background-color: #fff;
  border: 1px solid #ccc;
  border-radius: .5rem;
  width: 15.625rem;
  max-height: 12.5rem;
  position: absolute;
  top: 3.125rem;
  overflow-y: auto;
  box-shadow: 0 .125rem .5rem #0003;
}

.searchItem {
  cursor: pointer;
  border-bottom: 1px solid #eee;
  padding: .5rem .625rem;
}

.searchItem:hover {
  background-color: #f5f5f5;
}

.noResult {
  color: gray;
  text-align: center;
  padding: .625rem;
}

.formContainer {
  flex-direction: column;
  align-items: center;
  margin-bottom: .625rem;
  font-family: sans-serif;
  display: flex;
}

.formBox {
  background-color: #f9f9f9;
  border-radius: .625rem;
  flex-direction: column;
  gap: .9375rem;
  width: 18.75rem;
  padding: 1.25rem;
  display: flex;
  box-shadow: 0 .1875rem .5rem #0003;
}

label {
  flex-direction: column;
  font-size: .9375rem;
  display: flex;
}

input {
  border: 1px solid #aaa;
  border-radius: .3125rem;
  outline: none;
  margin-top: .3125rem;
  padding: .5rem;
  font-size: .875rem;
}

input:focus {
  border-color: #007bff;
}

.error {
  color: red;
  margin-top: .1875rem;
  font-size: .8125rem;
}

button {
  color: #fff;
  cursor: pointer;
  background-color: #007bff;
  border: none;
  border-radius: .375rem;
  padding: .5rem 0;
  font-size: 1rem;
  transition: all .2s;
}

button:hover {
  background-color: #0056b3;
}

@media (width <= 1024px) {
  .containerCards {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding: 2rem 3rem;
  }

  .animatedCard {
    max-width: 400px;
    height: 320px;
  }

  .card-preview-video {
    height: 200px;
  }
}

@media (width <= 768px) {
  .containerCards {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 2rem;
  }

  .animatedCard {
    width: 90%;
    max-width: 360px;
    height: auto;
  }

  .card-preview-video {
    border-radius: 12px;
    width: 100%;
    height: 180px;
  }

  .navLinks {
    gap: 10px;
  }

  .logo {
    font-size: 1.25rem;
  }

  .resumeButton, .navButton {
    padding: 6px 14px;
    font-size: .9rem;
  }

  .footer {
    padding: 10px 0;
    font-size: 12px;
  }

  .naruto-runner {
    display: none;
  }
}

@media (width <= 480px) {
  .containerCards {
    gap: 1rem;
    padding: 1rem;
  }

  .animatedCard {
    width: 100%;
    max-width: none;
    height: auto;
  }

  .card-preview-video {
    border-radius: 10px;
    height: 150px;
  }

  .animatedCard-content h3 {
    font-size: 1.1rem;
  }

  .animatedCard-content p {
    font-size: .85rem;
  }

  .navLinks {
    flex-wrap: wrap;
    justify-content: center;
  }

  .navButton, .resumeButton {
    padding: 6px 12px;
    font-size: .8rem;
  }

  .footer {
    font-size: 11px;
  }
}

.hero-section {
  background-color: #0000;
  background-image: radial-gradient(circle at 30% 30%, #0078ff26, #0000 60%), radial-gradient(circle at 70% 70%, #ffc8501f, #0000 60%), linear-gradient(#060b17 0%, #000 100%);
  background-position: 0 0, 0 0, 0 0;
  background-repeat: repeat, repeat, repeat;
  background-size: auto, auto, auto;
  background-attachment: fixed;
  background-origin: padding-box, padding-box, padding-box;
  background-clip: border-box, border-box, border-box;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  display: flex;
  position: relative;
  overflow: hidden;
}

.particles:before, .particles:after {
  content: "";
  pointer-events: none;
  z-index: 0;
  background: radial-gradient(circle, #ffffff12, #0000 60%);
  width: 100%;
  height: 100%;
  animation: 3s ease-in-out infinite alternate flicker;
  position: absolute;
}

@keyframes flicker {
  0% {
    opacity: .4;
  }

  100% {
    opacity: .8;
  }
}

.hero-content {
  text-align: center;
  z-index: 2;
  position: relative;
  transform: translateY(-10%);
}

.hero-name {
  color: #fff;
  text-shadow: 0 0 15px #6ef3ff, 0 0 30px #00bfff;
  font-size: 3rem;
  font-weight: 700;
  animation: 3s ease-in-out infinite glowPulse;
}

@keyframes glowPulse {
  0% {
    text-shadow: 0 0 10px #6ef3ff, 0 0 20px #00bfff;
  }

  50% {
    text-shadow: 0 0 20px #fff, 0 0 40px #0ff;
  }

  100% {
    text-shadow: 0 0 10px #6ef3ff, 0 0 20px #00bfff;
  }
}

.hero-tagline {
  color: #dcdcdc;
  letter-spacing: 1px;
  opacity: 0;
  margin-top: 10px;
  margin-bottom: 10px;
  font-size: 1.3rem;
  animation: 2s 1s forwards fadeIn;
}

.lightning-flash {
  opacity: 0;
  pointer-events: none;
  z-index: 1;
  background: radial-gradient(circle, #fffc, #0000 70%);
  width: 100%;
  height: 100%;
  transition: opacity .2s;
  position: absolute;
  top: 0;
  left: 0;
}

.lightning-flash.active {
  opacity: 1;
  transition: opacity .1s ease-out;
}

.scroll-hint {
  cursor: pointer;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  display: flex;
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
}

.scroll-text {
  color: #aaa;
  letter-spacing: 1px;
  text-transform: lowercase;
  font-size: .9rem;
  animation: 2.5s ease-in-out infinite fadeHint;
}

@keyframes fadeHint {
  0%, 100% {
    opacity: .6;
  }

  50% {
    opacity: 1;
  }
}

.arrows span {
  color: #0ff;
  opacity: 0;
  font-size: 1.4rem;
  animation: 2s infinite bounce;
  display: block;
}

.arrows span:first-child {
  animation-delay: 0s;
}

.arrows span:nth-child(2) {
  animation-delay: .3s;
}

.arrows span:nth-child(3) {
  animation-delay: .6s;
}

@keyframes bounce {
  0% {
    opacity: .1;
    transform: translateY(0);
  }

  50% {
    opacity: 1;
    transform: translateY(8px);
  }

  100% {
    opacity: .1;
    transform: translateY(0);
  }
}

html, body, #root, .app-root {
  background: #000;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

.hero-wrapper {
  justify-content: center;
  align-items: center;
  width: 100vw;
  height: 100vh;
  margin: 0;
  display: flex;
  position: relative;
  overflow: hidden;
}

#components-section {
  scroll-margin-top: 80px;
}

.header {
  z-index: 9999;
  backdrop-filter: blur(12px);
  background: #0a0c14d9;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 14px 60px;
  transition: opacity .5s, transform .5s;
  display: flex;
  position: fixed;
  top: 0;
  left: 0;
  box-shadow: 0 2px 20px #0096ff26;
}

.header.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(-100%);
}

.header.visible {
  opacity: 1;
  transform: translateY(0);
}

.header-content {
  color: #e8f3ff;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: 1200px;
  display: flex;
}

.header {
  transition: opacity .6s, transform .6s;
}

.swiggy-page {
  color: #333;
  background-color: #fff;
  font-family: Inter, sans-serif;
}

.swiggy-header {
  color: #fff;
  background-color: #fc8019;
  justify-content: space-between;
  align-items: center;
  padding: 15px 30px;
  display: flex;
}

.swiggy-logo {
  align-items: center;
  gap: 10px;
  display: flex;
}

.swiggy-logo img {
  border-radius: 50%;
  width: 40px;
}

.swiggy-search input {
  border: none;
  border-radius: 8px;
  width: 300px;
  padding: 8px 16px;
}

.swiggy-buttons button {
  color: #fc8019;
  cursor: pointer;
  background-color: #fff;
  border: none;
  border-radius: 8px;
  margin-left: 10px;
  padding: 8px 16px;
  font-weight: 600;
}

.swiggy-buttons .signin {
  color: #fff;
  background-color: #000;
}

.swiggy-hero {
  color: #fff;
  text-align: center;
  background-color: #fc8019;
  padding: 60px 20px;
}

.hero-actions {
  justify-content: center;
  gap: 10px;
  display: flex;
}

.hero-actions input {
  border: none;
  border-radius: 8px;
  width: 300px;
  padding: 10px;
}

.hero-actions button {
  color: #fff;
  cursor: pointer;
  background-color: #000;
  border: none;
  border-radius: 8px;
  padding: 10px 20px;
}

.restaurant-section {
  background-color: #fafafa;
  padding: 40px;
}

.restaurant-grid {
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 25px;
  display: grid;
}

.restaurant-card {
  background: #fff;
  border-radius: 10px;
  transition: transform .3s;
  overflow: hidden;
  box-shadow: 0 3px 6px #00000014;
}

.restaurant-card:hover {
  transform: scale(1.03);
}

.restaurant-card img {
  object-fit: cover;
  width: 100%;
  height: 180px;
}

.restaurant-info {
  padding: 15px;
}

.restaurant-info h4 {
  margin-bottom: 5px;
  font-size: 18px;
}

.cuisines {
  color: #777;
  margin-bottom: 10px;
  font-size: 14px;
}

.info-row {
  color: #444;
  justify-content: space-between;
  font-size: 14px;
  display: flex;
}

.swiggy-footer {
  text-align: center;
  background-color: #f0f0f0;
  margin-top: 40px;
  padding: 20px;
}
